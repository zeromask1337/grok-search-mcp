{
  "name": "xai-mcp-server",
  "version": "0.1.0",
  "description": "MCP server for XAI x_search tool",
  "license": "MIT",
  "type": "module",
  "bin": {
    "xai-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "SETUP.md",
    "TESTING.md",
    "PLAN.md",
    "evaluation.xml",
    "LICENSE",
    ".env.example"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "hono": "^4.6.15",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "^5.9.3"
  }
}
